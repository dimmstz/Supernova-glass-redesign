<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_lumi_weather_widget">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/weatherWidgetIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀"
                android:textColor="#FFE08A"
                android:textSize="30sp" />
            <TextView
                android:id="@+id/weatherWidgetTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/weatherWidgetCondition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#D6E4FF"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/weatherWidgetLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#A8C8F0"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:id="@+id/weatherWidgetClock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/weatherWidgetDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#C6D7F0"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/weatherWidgetHighLow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="end"
                android:textColor="#DDEAFF"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/weatherForecastDay1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#E6F0FF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1" />
    <TextView
        android:id="@+id/weatherForecastInfo1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9EC5F1"
        android:textSize="11sp"
        android:maxLines="1" />
    <TextView
        android:id="@+id/weatherForecastDay2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#E6F0FF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1" />
    <TextView
        android:id="@+id/weatherForecastInfo2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9EC5F1"
        android:textSize="11sp"
        android:maxLines="1" />
    <TextView
        android:id="@+id/weatherForecastDay3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#E6F0FF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1" />
    <TextView
        android:id="@+id/weatherForecastInfo3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9EC5F1"
        android:textSize="11sp"
        android:maxLines="1" />
</LinearLayout>
