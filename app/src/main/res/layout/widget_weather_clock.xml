<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_lumi_weather_widget">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.02"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/weatherWidgetIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀️"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/weatherWidgetTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:textColor="#F7FAFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/weatherWidgetCondition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#D6E4FF"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/weatherWidgetLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#91B8E8"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="72dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="14dp"
            android:background="#42D5E6FF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/weatherWidgetClock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#FFFFFF"
                android:textSize="38sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <TextView
                android:id="@+id/weatherWidgetDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="end"
                android:textColor="#B8C9E7"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/weatherWidgetHighLow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:textColor="#DDEAFF"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="7dp"
        android:background="#32D5E6FF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:id="@+id/weatherForecastDay1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E6F0FF" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/weatherForecastInfo1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#9EC5F1" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:id="@+id/weatherForecastDay2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E6F0FF" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/weatherForecastInfo2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#9EC5F1" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:id="@+id/weatherForecastDay3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E6F0FF" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/weatherForecastInfo3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#9EC5F1" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
