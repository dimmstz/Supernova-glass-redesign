<?xml version="1.0" encoding="utf-8"?>
<!-- The active tab is a soft accent lens; the idle tab stays clear but keeps
     the same outline for a quiet, tactile press state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_control_radius" />
            <solid android:color="@color/accent_container" />
            <stroke
                android:width="@dimen/glass_stroke_width"
                android:color="@color/glassSpecularSoft" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_control_radius" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
