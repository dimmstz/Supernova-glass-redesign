<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="26dp" />
            <gradient
                android:angle="135"
                android:startColor="#F31B2940"
                android:centerColor="#E4142035"
                android:endColor="#F1081224" />
            <stroke android:width="1dp" android:color="#66D5E8FF" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp">
        <shape>
            <corners android:radius="25dp" />
            <gradient
                android:angle="315"
                android:startColor="#182E6B9E"
                android:centerColor="#00162848"
                android:endColor="#183E287B" />
        </shape>
    </item>
</layer-list>
