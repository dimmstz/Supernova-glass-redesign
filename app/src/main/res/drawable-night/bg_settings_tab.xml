<?xml version="1.0" encoding="utf-8"?>
<!-- Neutral selected tab for the graphite dark settings theme. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_control_radius" />
            <solid android:color="@color/settingsAccent" />
            <stroke
                android:width="@dimen/glass_stroke_width"
                android:color="@color/glassSpecularSoft" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_control_radius" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
